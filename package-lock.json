const { Octokit } = require("@octokit/rest");

const octokit = new Octokit({ auth: process.env.GITHUB_TOKEN });
const ORG = process.env.GITHUB_ORG;

let repoCache = { data: [], fetchedAt: 0 };
const REPO_CACHE_TTL_MS = 5 * 60 * 1000;

module.exports = {
  octokit,
  ORG,

  // Cached list of repo names in the org, used for slash-command autocomplete
  // and the /repos command so we're not hitting the API on every keystroke.
  async listOrgRepos({ force = false } = {}) {
    const now = Date.now();
    if (!force && repoCache.data.length && now - repoCache.fetchedAt < REPO_CACHE_TTL_MS) {
      return repoCache.data;
    }
    const repos = await octokit.paginate(octokit.rest.repos.listForOrg, {
      org: ORG,
      per_page: 100,
    });
    repoCache = { data: repos.map((r) => r.name), fetchedAt: now };
    return repoCache.data;
  },

  async userExists(username) {
    try {
      await octokit.rest.users.getByUsername({ username });
      return true;
    } catch (err) {
      if (err.status === 404) return false;
      throw err;
    }
  },

  async createIssue(repo, title, body) {
    const { data } = await octokit.rest.issues.create({
      owner: ORG,
      repo,
      title,
      body,
    });
    return data;
  },

  async closeIssue(repo, issueNumber) {
    const { data } = await octokit.rest.issues.update({
      owner: ORG,
      repo,
      issue_number: issueNumber,
      state: "closed",
    });
    return data;
  },

  async getIssue(repo, issueNumber) {
    const { data } = await octokit.rest.issues.get({
      owner: ORG,
      repo,
      issue_number: issueNumber,
    });
    return data;
  },

  async addComment(repo, issueNumber, body) {
    const { data } = await octokit.rest.issues.createComment({
      owner: ORG,
      repo,
      issue_number: issueNumber,
      body,
    });
    return data;
  },
};
